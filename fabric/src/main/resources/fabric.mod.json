{
  "schemaVersion": 1,
  "id": "optimized_fullbright",
  "version": "${version}",
  "name": "Optimized Fullbright",
  "description": "Fullbright mod that disables the lighting system to improve performance.",
  "authors": [
    "ray"
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "MIT",
  "icon": "assets/optimizedfullbright/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.ray.fullbright.fabric.OptimizedFullbright"
    ],
    "client": [
      "net.ray.fullbright.fabric.OptimizedFullbrightClient"
    ]
  },
  "mixins": [
    "optimized_fullbright.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=21.6",
    "java": ">=17",
    "fabric-api": "*"
  },
  "custom": {
    "badoptimizations:incompatibilities": [
      "enable_sky_color_caching",
      "enable_lightmap_caching"
    ]
  }
}
